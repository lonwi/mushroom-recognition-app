{
  "name": "mushroom-recognition-app",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "^22 || ^24"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:baseline": "eslint . --suppress-all --pass-on-unpruned-suppressions",
    "duplication": "jscpd --no-colors --config .jscpd.json",
    "duplication:strict": "jscpd --no-colors --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones",
    "duplication:update": "jscpd --no-colors --config .jscpd.json --baseline .jscpd-baseline.json --update-baseline",
    "knip": "node scripts/knip-baseline.mjs",
    "knip:update": "node scripts/knip-baseline.mjs --update",
    "depcruise": "node scripts/depcruise-gate.mjs && node --test scripts/quality-gates.test.mjs",
    "depcruise:tighten": "node scripts/depcruise-gate.mjs --shrink",
    "depcruise:baseline": "node scripts/depcruise-gate.mjs --update",
    "quality": "pnpm lint && pnpm duplication && pnpm knip && pnpm depcruise",
    "test": "jest --config jest.config.js",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-camera": "^58.0.10",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "^57.0.0",
    "expo-location": "^57.0.0",
    "expo-splash-screen": "~57.0.9",
    "react": "^19.2.3",
    "react-native": "^0.86.3",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.10.0",
    "react-native-web": "^0.21.3",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^57.0.0",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.13.0",
    "jest": "^30.0.0",
    "jest-expo": "^57.0.5",
    "jscpd": "5.4.0",
    "knip": "6.40.0",
    "storybook": "^8.6.14",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.1"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "shell-quote": "1.12.0",
      "source-map-js": "1.2.2",
      "xcode>uuid": "11.1.1",
      "@storybook/addon-actions>uuid": "11.1.1",
      "handlebars": "4.7.10"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-85393",
        "CVE-2026-93687",
        "CVE-2026-97058"
      ]
    }
  }
}
