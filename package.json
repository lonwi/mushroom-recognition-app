{
  "name": "mushroom-recognition-app",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "^22 || ^24"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:knip": "knip",
    "duplication": "jscpd --no-colors --config .jscpd.json",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "jest --ci",
    "build:site": "tsx scripts/site/generator.tsx",
    "check:site": "node scripts/check-site.mjs",
    "quality": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm duplication && pnpm check:knip && pnpm check:deps && pnpm test && pnpm check:site",
    "export:android": "node ./scripts/export-android.cjs",
    "compile:android-kotlin": "node ./scripts/compile-android-kotlin.cjs",
    "build:species": "tsx scripts/build-species-db.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@rn-primitives/slot": "1.5.2",
