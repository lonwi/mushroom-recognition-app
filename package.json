{
  "name": "mushroom-recognition-app",
  "version": "1.0.0",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "^22 || ^24"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 --pass-on-unpruned-suppressions",
    "lint:prune": "eslint . --prune-suppressions",
    "lint:baseline": "eslint . --suppress-all --pass-on-unpruned-suppressions",
    "duplication": "jscpd --no-colors --config .jscpd.json",
    "duplication:strict": "jscpd --no-colors --config .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones",
    "duplication:update": "jscpd --no-colors --config .jscpd.json --baseline .jscpd-baseline.json --update-baseline",
    "knip": "node scripts/knip-baseline.mjs",
    "knip:update": "node scripts/knip-baseline.mjs --update",
    "depcruise": "node scripts/depcruise-gate.mjs && node --test scripts/quality-gates.test.mjs",
    "depcruise:tighten": "node scripts/depcruise-gate.mjs --shrink",
    "depcruise:baseline": "node scripts/depcruise-gate.mjs --update",
    "quality": "pnpm lint && pnpm duplication && pnpm knip && pnpm depcruise && pnpm check:site",
    "check:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-site.mjs",
    "test": "jest --config jest.config.js",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.23",
    "expo-asset": "~58.0.20",
    "expo-camera": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-location": "~58.0.20",
    "expo-splash-screen": "~58.0.13",
    "react": "^19.2.3",
    "react-native": "0.88.1",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-paper": "^5.15.3",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-web": "^0.21.4",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "^8.6.19",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "babel-preset-expo": "^58.0.17",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-native": "5.0.0",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "17.14.0",
    "jest": "^30.0.0",
    "jest-expo": "^58.0.14",
    "jscpd": "5.4.0",
    "knip": "6.44.1",
    "storybook": "^8.6.19",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5"
  },
  "private": true
}
