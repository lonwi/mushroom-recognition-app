{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "pnpm": "12.16.1",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "pnpm": "12.16.1",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "pnpm": "12.16.1",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "applicationId": "com.grzybobranie.ai"
      },
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APPLE_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
        "bundleIdentifier": "com.grzybobranie.ai"
      }
    }
  }
}
