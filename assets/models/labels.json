{
  "role": "class_contract",
  "note": "This file is the class contract for a model we train ourselves. It is not a neural network. Recognition stays unavailable until training/export_tflite.py copies a calibrated mushrooms_model.tflite into this folder and sets model_packaged to true. No species, confidence, or edibility is implied by this list. safety_tag and taxon toxic flags are evaluation labels for the ship gates. The app must not show them as an edibility verdict. unknown_mushroom means a fungus that is not one of the known species. It is not a species name and not an edibility verdict. not_a_mushroom stays last.",
  "model_file": "mushrooms_model.tflite",
  "model_packaged": false,
  "recognition_available": false,
  "backbone": {
    "name": "MobileNetV3Small",
    "framework": "keras.applications.MobileNetV3Small",
    "pretrained_weights": "imagenet",
    "pretrained_weights_license": "see training/README.md",
    "pretrained_weights_source": "keras.applications.MobileNetV3Small weights='imagenet', file weights_mobilenet_v3_small_224_1.0_float_no_top_v2.h5 from https://storage.googleapis.com/tensorflow/keras-applications/mobilenet_v3/. License statements are quoted in training/README.md and are not a legal conclusion."
  },
  "input": {
    "size": 224,
    "channels": 3,
    "layout": "NHWC",
    "color": "RGB",
    "preprocess": "mobilenet_v3",
    "formula": "(pixel / 127.5) - 1",
    "resize": "area_antialias_downsample_uint8_round_half_up_else_bilinear_half_pixel_centers",
    "native_long_edge": 448
  },
  "output": {
    "type": "logits",
    "activation": "none",
    "io_dtype": "float32"
  },
  "quantization": null,
  "dangerous_genera": [
    "Amanita",
    "Cortinarius",
    "Galerina",
    "Gyromitra"
  ],
  "ood": {
    "method": "energy_logsumexp_plus_background_class",
    "reference": "Liu et al., Energy-based Out-of-distribution Detection, NeurIPS 2020. E(x) = -T * logsumexp(logits / T). In-distribution scores are lower. Reject when E(x) is above the calibrated threshold, when the background class wins, or when the top softmax is below the accept floor. A softmax cutoff alone is not the gate.",
    "background_class_id": "not_a_mushroom",
    "temperature": 1,
    "energy_threshold": null,
    "min_softmax_for_accept": null,
    "min_top1_softmax_for_high_confidence": null,
    "min_margin": null,
    "calibrated": false,
    "id_keep_rate_at_threshold": null,
    "ood_reject_rate_at_threshold": null,
    "softmax_above_0_5_still_rejected_rate": null,
    "unknown_class_id": "unknown_mushroom"
  },
