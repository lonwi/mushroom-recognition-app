{
  "expo": {
    "name": "Grzybobranie AI",
    "slug": "mushroom-recognition-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "grzybobranie",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F6F5F1",
    "updates": {
      "enabled": false
    },
    "android": {
      "package": "com.grzybobranie.ai",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6F5F1"
      },
      "permissions": ["android.permission.CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "com.grzybobranie.ai",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      "expo-sharing",
      "expo-system-ui",
      "expo-camera",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F1",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "202773d8-f2cf-436a-9a1b-964b3fdd7b20"
      }
    },
    "owner": "lonwi"
  }
}
